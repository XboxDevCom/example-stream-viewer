<Page
    x:Class="StreamViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Stream Viewer"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,24,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ComboBox x:Name="PlatformSelector"
                          Header="Plattform"
                          MinWidth="200"
                          MinHeight="48"
                          Margin="0,0,12,0"
                          SelectionChanged="PlatformSelector_SelectionChanged"
                          XYFocusRight="ChannelInput"/>
                <TextBox x:Name="ChannelInput"
                         Header="Kanalname"
                         MinWidth="300"
                         MinHeight="48"
                         Margin="0,0,12,0"
                         PlaceholderText="z.B. shroud"
                         KeyDown="ChannelInput_KeyDown"
                         XYFocusLeft="PlatformSelector"
                         XYFocusRight="WatchButton"/>
                <Button x:Name="WatchButton"
                        Content="Ansehen"
                        MinHeight="48"
                        MinWidth="120"
                        Click="WatchButton_Click"
                        XYFocusLeft="ChannelInput"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Border x:Name="StreamWebViewBorder"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <WebView x:Name="StreamWebView"
                         NavigationCompleted="StreamWebView_NavigationCompleted"/>
            </Border>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <TextBlock Text="📺"
                           FontSize="72"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Wähle eine Plattform und gib einen Kanalnamen ein"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="500"
                           Margin="0,0,0,24"/>
                <TextBlock Text="Beliebte Kanäle:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <StackPanel x:Name="PresetChannels"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentPlatformText"
                       Grid.Column="0"
                       FontSize="14"
                       Foreground="Gray"
                       Text="Plattform: Twitch"/>
            <TextBlock x:Name="CurrentChannelText"
                       Grid.Column="1"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
